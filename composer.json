{
	"name": "miziomon/wp-simple-access-control",
	"description": "Restrict access to single contents and to single blocks by user role, with an inline login form and an access log.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Maurizio Pelizzone",
			"email": "maurizio@mavida.com"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.4",
		"phpstan/extension-installer": "^1.4"
	},
	"autoload": {
		"psr-4": {
			"WPSimpleAccessControl\\": "src/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"lint": [
			"@phpcs",
			"@phpstan"
		]
	}
}
